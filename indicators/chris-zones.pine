//@version=6
indicator("Chris's Zones", overlay=true, max_boxes_count=500)

isES = syminfo.root == "ES" or syminfo.root == "MES"
isNQ = syminfo.root == "NQ" or syminfo.root == "MNQ"

var float[] mids = array.new<float>()
var float half = 0.0

if isES
    mids := array.from(
        6318.0, 6372.0, 6427.0, 6481.0, 6536.0, 6590.0, 6645.0, 6699.0,
        6754.0, 6808.0, 6863.0, 6917.0, 6972.0, 7026.0, 7081.0, 7135.0
    )
    half := 1.5
else if isNQ
    mids := array.from(
        22984.0, 23136.0, 23288.0, 23440.0, 23592.0, 23744.0, 23896.0, 24048.0,
        24200.0, 24352.0, 24504.0, 24656.0, 24808.0, 24960.0, 25112.0, 25264.0,
        25416.0, 25568.0, 25720.0, 25872.0, 26024.0, 26176.0, 26328.0, 26480.0,
        26632.0, 26784.0
    )
    half := 6.0

if barstate.islast
    for m in mids
        color zoneColor = m < close ? color.green : color.red
        box.new(
            left   = time,
            top    = m + half,
            right  = time,
            bottom = m - half,
            xloc   = xloc.bar_time,
            border_color = color.new(zoneColor, 40),
            border_width = 1,
            bgcolor      = color.new(zoneColor, 85),
            extend = extend.both
        )
